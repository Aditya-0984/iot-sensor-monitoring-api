{
  "info": {
    "name": "IoT Sensor Monitoring API",
    "description": "Collection untuk pengujian API lokal. Jalankan seed.py terlebih dahulu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" },
    { "key": "device_key", "value": "demo-iot-key-123" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{base_url}}/api/health" }
    },
    {
      "name": "List Sites",
      "request": { "method": "GET", "url": "{{base_url}}/api/sites" }
    },
    {
      "name": "List Devices",
      "request": { "method": "GET", "url": "{{base_url}}/api/devices" }
    },
    {
      "name": "List Sensors",
      "request": { "method": "GET", "url": "{{base_url}}/api/sensors" }
    },
    {
      "name": "Ingest Normal Reading",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Device-Key", "value": "{{device_key}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"sensor_id\": 1,\n  \"value\": 27.5\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{base_url}}/api/readings"
      }
    },
    {
      "name": "Ingest Out-of-Range Reading (Creates Alert)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Device-Key", "value": "{{device_key}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"sensor_id\": 1,\n  \"value\": 34\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{base_url}}/api/readings"
      }
    },
    {
      "name": "List Readings (Pagination)",
      "request": { "method": "GET", "url": "{{base_url}}/api/readings?page=1&per_page=10&sort=desc&sensor_id=1" }
    },
    {
      "name": "List Alerts",
      "request": { "method": "GET", "url": "{{base_url}}/api/alerts?status=open&page=1&per_page=10" }
    },
    {
      "name": "List Maintenance Logs",
      "request": { "method": "GET", "url": "{{base_url}}/api/maintenance-logs" }
    },
    {
      "name": "Ingest With Wrong Key (Expected 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Device-Key", "value": "wrong-key" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"sensor_id\": 1,\n  \"value\": 25\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{base_url}}/api/readings"
      }
    }
  ]
}
